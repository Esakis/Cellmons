DATABASE_URL=postgres://game_app:REPLACE_URI_ENCODED_PASSWORD@postgres:5432/game
DB_POOL_SIZE=32
PUBLIC_ORIGIN=https://REPLACE_OWNER_DOMAIN
APP_ORIGINS=https://localhost
APP_MIN_NATIVE_VERSION=1.0.0
LEGAL_APPROVED_VERSION=2026-10-16
MAIL_MODE=smtp
SMTP_HOST=REPLACE_OWNER_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_OWNER_SMTP_USER
SMTP_PASSWORD=REPLACE_OWNER_SMTP_PASSWORD
SMTP_FROM=REPLACE_OWNER_EMAIL
WS_TICKET_KEY=REPLACE_64_HEX_RANDOM_CHARACTERS
TURNSTILE_SITE_KEY=REPLACE_OWNER_SITE_KEY
TURNSTILE_SECRET=REPLACE_OWNER_SECRET
WS_MAX_CONNECTIONS=5000
WS_CONNECTIONS_PER_IP=20
WS_ROOM_CAPACITY=1000
DUEL_MAX_ACTIVE=2048
DUEL_LEASE_SECONDS=15
