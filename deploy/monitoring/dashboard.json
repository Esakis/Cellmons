{
  "uid": "spellgambit",
  "title": "Spellgambit operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "sum(ws_connections)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active duels",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "max(duels_active)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Round p95",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(duel_round_latency_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP errors",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "sum(rate(http_responses_total{class=\"5xx\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pool use",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "max(db_pool_in_use / clamp_min(db_pool_size,1))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Maintenance age",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "time()-max(operation_last_success_seconds{operation=\"maintenance\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backup age",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "time()-game_backup_success_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "WAL archive failure",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "game-metrics"
      },
      "targets": [
        {
          "expr": "max(wal_archive_failed)",
          "refId": "A"
        }
      ]
    }
  ]
}
