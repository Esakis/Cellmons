{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id,f.login::text AS \"sender!\",t.login::text AS \"recipient!\",m.body,(EXTRACT(EPOCH FROM m.created_at)*1000)::bigint AS \"at_ms!\",m.read_at IS NOT NULL AS \"read!\" FROM mail m JOIN users f ON f.id=m.from_user JOIN users t ON t.id=m.to_user WHERE (($3 AND m.from_user=$1 AND NOT m.deleted_by_sender) OR (NOT $3 AND m.to_user=$1 AND NOT m.deleted_by_recipient)) AND ($2::uuid IS NULL OR m.id<$2) ORDER BY m.id DESC LIMIT $4",
