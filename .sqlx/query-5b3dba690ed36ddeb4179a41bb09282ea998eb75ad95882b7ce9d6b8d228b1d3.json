{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id,m.kind,a.login::text AS \"first!\",COALESCE(b.login::text,'AI') AS \"second!\",m.winner,m.reason,(extract(epoch FROM m.created_at)*1000)::bigint AS \"at!\" FROM matches m JOIN users a ON a.id=m.first_user LEFT JOIN users b ON b.id=m.second_user WHERE (m.first_user=$1 OR m.second_user=$1) AND ($2::uuid IS NULL OR m.id<$2) ORDER BY m.id DESC LIMIT $3",
