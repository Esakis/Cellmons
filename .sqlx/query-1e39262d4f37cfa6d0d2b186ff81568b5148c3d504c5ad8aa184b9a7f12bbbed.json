  "query": "SELECT t.id,e.delta,t.reason,t.ref_id,(extract(epoch FROM t.created_at)*1000)::bigint AS \"at!\" FROM ledger_entries e JOIN ledger_transactions t ON t.id=e.tx_id WHERE e.account=$1 ORDER BY t.id DESC LIMIT 50",
