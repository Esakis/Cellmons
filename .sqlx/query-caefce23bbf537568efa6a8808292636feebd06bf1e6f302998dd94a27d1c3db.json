{
  "db_name": "PostgreSQL",
  "query": "SELECT (EXISTS(SELECT 1 FROM duel_locks l WHERE l.user_id=u.id) OR EXISTS(SELECT 1 FROM activity_locks l WHERE l.user_id=u.id)) AS \"busy!\",u.id,u.login::text AS \"login!\",u.description,u.challenge_filter,u.email_verified_at IS NOT NULL AS \"verified!\",COALESCE(r.rating,1000) AS \"rating!\",c.id AS clan_id,c.name::text AS clan_name,m.title FROM users u LEFT JOIN ratings r ON r.user_id=u.id LEFT JOIN clan_members m ON m.user_id=u.id LEFT JOIN clans c ON c.id=m.clan_id AND c.status='active' WHERE u.id=$1 AND u.status='active'",
