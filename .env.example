# Lokalna konfiguracja serwera gry (docs/08-serwer.md, rozdz. 13).
# run.bat kopiuje ten plik do .env, jeśli .env nie istnieje. Plik .env nie trafia do repozytorium.

# Baza z deploy/docker-compose.dev.yml (port 5433 na hoście).
DATABASE_URL=postgres://game:game@127.0.0.1:5433/game

# Opcjonalne osobne poświadczenia DDL; korzysta z nich wyłącznie polecenie `server migrate`.
# W produkcji DATABASE_URL wskazuje rolę game_app, a MIGRATION_DATABASE_URL game_migrator.
# MIGRATION_DATABASE_URL=postgres://game_migrator:...@127.0.0.1:5432/game

# Lokalnie tylko 127.0.0.1. Domyślny port 8080 często zajmują inne programy.
# Klient (Vite) czyta ten adres, żeby przekazywać zapytania do serwera.
LISTEN_ADDR=127.0.0.1:8090

LOG_LEVEL=info
LOG_FORMAT=text
# Opcjonalny osobny listener metryk; nigdy nie wystawiaj go publicznie.
# OPS_LISTEN_ADDR=127.0.0.1:19091

# Konta: dokładny adres klienta, bez końcowego ukośnika. HTTP dozwolone tylko na loopback.
PUBLIC_ORIGIN=http://localhost:5173
APP_ORIGINS=https://localhost
APP_MIN_NATIVE_VERSION=1.0.0
# Po odbiorze prawnym, poza loopback: wersja dokumentów musi odpowiadać serwerowi.
# LEGAL_APPROVED_VERSION=2026-10-16
# Build publiczny: PUBLIC_RELEASE=1 i LEGAL_CONFIG=<uzupełniony plik zgodny z legal/site.example.json>

# Lokalna poczta trafia do target/mail/*.json; link w body otwiera ekran potwierdzenia/resetu.
# Poza loopback wymagane są MAIL_MODE=smtp, SMTP_* oraz klucze Turnstile i biletu.
MAIL_MODE=file
MAIL_OUTBOX=target/mail
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=game@example.org
# WS_TICKET_KEY=<64 znaki szesnastkowe, losowe 32 bajty>
# TURNSTILE_SITE_KEY=...
# TURNSTILE_SECRET=...
# TRUSTED_PROXY_IPS=127.0.0.1

# Tylko build Androida: dokładny adres HTTPS API (bez ścieżki i końcowego ukośnika).
# VITE_API_ORIGIN=https://game.example.org
# Wydanie Androida (klucze prywatne i hasła tylko w chronionym środowisku CI):
# ANDROID_APPLICATION_ID=<trwały identyfikator należący do wydawcy>
# ANDROID_VERSION=1.0.0
# WEB_BUNDLE_VERSION=1
# WEB_BUNDLE_URL=https://game.example.org/app-bundles/
# WEB_BUNDLE_PUBLIC_KEY=<32 surowe bajty Ed25519 w Base64>
# WEB_BUNDLE_SIGNING_KEY=<ścieżka do chronionego klucza PEM; wyłącznie narzędzie pakujące>

# WebSocket: limity jednoczesnych połączeń (także przed Hello).
WS_CONNECTIONS_PER_IP=20
WS_MAX_CONNECTIONS=5000
WS_ROOM_CAPACITY=1000
DUEL_MAX_ACTIVE=2048
DUEL_LEASE_SECONDS=15

# Panel administracyjny domyślnie wyłączony. Obie wartości są wymagane razem.
# Klucz: 32 losowe bajty zapisane jako 64 znaki hex; przechowuj w menedżerze sekretów.
# ADMIN_TOTP_KEY=...
# ADMIN_ALLOWED_IPS=198.51.100.2/32,2001:db8::2/128
# Pierwszego administratora nadaj z konsoli, nigdy przez publiczne API:
# cargo run -p server -- admin role LOGIN admin "Powód nadania uprawnień"
