root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

# Windows PowerShell 5.1 czyta skrypty bez BOM w kodowaniu systemowym, więc polskie znaki wymagają BOM.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
